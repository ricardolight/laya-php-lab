{
    "name": "ricardolight/laya-eval",
    "description": "Evaluate and calibrate classifier decisions: confusion matrix, precision/recall, Brier, ECE and confidence-threshold sweeps.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "LayaEval\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --no-progress",
        "lint": "pint --test",
        "format": "pint",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
