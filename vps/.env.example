# Copy to .env (git-ignored) and fill in. Read by `docker compose` and, when sourced, by the PHP projects.

# Bearer token laya-serve requires on every request. Generate one with: openssl rand -hex 32
LAYA_API_KEY=

# Where the PHP projects find laya-serve.
LAYA_URL=http://127.0.0.1:8000

# Host port (bound to 127.0.0.1 only).
LAYA_PORT=8000

# torch threads for CPU inference; keep at or below the physical cores you can spare.
LAYA_THREADS=6

# 1 = load checkpoints at startup. LAYA_MODELS limits which ones (e.g. "english,multilingual"); empty = all three.
LAYA_PRELOAD=1
LAYA_MODELS=

# "reviewed" = pinned checkpoint SHAs (reproducible). Empty = latest on the Hub.
LAYA_REVISION=reviewed

# Router fallback for text with no clear language evidence (very short Latin text such as "Ok").
# Empty = english. Try "multilingual" when most of your traffic is Bahasa Indonesia, and compare.
LAYA_DEFAULT_MODEL=

# Requests handled at once before laya-serve answers 503 (ServerBusyException in PHP).
LAYA_MAX_CONCURRENT=16

# 1 = never contact huggingface.co (only after the first successful start has cached the weights).
HF_HUB_OFFLINE=0
